# =============================================================================
# EchoScene — Environment Variables Example
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env to git (already listed in .gitignore)
# =============================================================================

# ---------------------------------------------------------------------------
# AI Pipeline — Ollama (Local LLM server)
# Run Ollama separately on host machine: ollama serve
# host.docker.internal resolves to the host machine from inside a container
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-vl:3b

# ---------------------------------------------------------------------------
# ChromaDB — Vector database (Connected via HTTP Client)
# When using Docker Compose, the host is the service name "chromadb"
# Data persistence is handled internally by the chromadb container volume
# ---------------------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_PATH=data/chromadb

# ---------------------------------------------------------------------------
# PostgreSQL — Relational database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://echoscene:echoscene_dev_password@postgres:5432/echoscene
POSTGRES_DB=echoscene
POSTGRES_USER=echoscene
POSTGRES_PASSWORD=echoscene_dev_password

# ---------------------------------------------------------------------------
# MinIO — Object storage (S3-compatible)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=echoscene
MINIO_ROOT_PASSWORD=echoscene_dev_password
MINIO_BUCKET_MEDIA=media
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_USE_SSL=false

# ---------------------------------------------------------------------------
# Media & Storage paths inside backend container
# ---------------------------------------------------------------------------
MEDIA_SOURCE_PATH=/app/data/media

# ---------------------------------------------------------------------------
# Whisper — Speech-to-text model size
# Options: tiny | base | small | medium | large
# tiny/base  : fast, low RAM — suitable for development
# medium/large: more accurate — requires GPU
# ---------------------------------------------------------------------------
WHISPER_MODEL_SIZE=base

# ---------------------------------------------------------------------------
# Frontend (Vite) — VITE_ prefix is required to expose variables to the browser
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=info
SECRET_KEY=change-this-to-a-random-secret-key-in-production
