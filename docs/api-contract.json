{
  "title": "SMA API Data Contract",
  "version": "v0.0.2-data-contract",
  "description": "Authoritative request/response schemas for all Smart Media Analytics API endpoints. Shared interface contract for M1 (AI pipeline), M2 (backend), and M3 (frontend).",
  "base_url": {
    "local": "http://localhost:8000",
    "docker": "http://backend:8000",
    "aws_future": "https://api.echoscene.io"
  },
  "enums": {
    "MediaType": ["video", "image", "audio"],
    "JobStatus": ["queued", "processing", "done", "failed"],
    "WhisperModel": ["tiny", "base", "small", "medium", "large"],
    "SortOrder": ["asc", "desc"],
    "AssetSortBy": ["ingested_at", "file_name", "duration_sec"],
    "WebSocketEvent": ["connected", "progress", "completed", "failed"]
  },
  "shared_types": {
    "SceneSnippet": {
      "type": "object",
      "description": "A brief scene reference used inside search results.",
      "required": ["scene_index", "timestamp_start_sec", "timestamp_end_sec", "caption"],
      "properties": {
        "scene_index": {
          "type": "integer",
          "description": "Zero-based scene index within the parent asset."
        },
        "timestamp_start_sec": {
          "type": "number",
          "description": "Scene start time in seconds."
        },
        "timestamp_end_sec": {
          "type": "number",
          "description": "Scene end time in seconds."
        },
        "caption": {
          "type": "string",
          "description": "Vision model (Llama 3.2 Vision) generated caption for this scene."
        },
        "transcript_snippet": {
          "type": ["string", "null"],
          "description": "Short Whisper transcript excerpt for this scene."
        }
      }
    },
    "SceneDetail": {
      "type": "object",
      "description": "Full scene object used inside asset detail responses.",
      "required": ["scene_index", "timestamp_start_sec", "timestamp_end_sec", "caption"],
      "properties": {
        "scene_index": {
          "type": "integer",
          "description": "Zero-based scene index within the parent asset."
        },
        "timestamp_start_sec": {
          "type": "number",
          "description": "Scene start time in seconds."
        },
        "timestamp_end_sec": {
          "type": "number",
          "description": "Scene end time in seconds."
        },
        "caption": {
          "type": "string",
          "description": "Vision model caption for this scene."
        },
        "transcript_snippet": {
          "type": ["string", "null"],
          "description": "Whisper transcript excerpt for this scene."
        },
        "thumbnail_url": {
          "type": ["string", "null"],
          "description": "Relative URL to the scene thumbnail image."
        },
        "embedding_id": {
          "type": "string",
          "description": "ChromaDB/FAISS vector ID for this scene's embedding."
        }
      }
    },
    "AssetSummary": {
      "type": "object",
      "description": "Lightweight asset object used in paginated list responses.",
      "required": ["asset_id", "file_name", "media_type", "file_size_bytes", "ingested_at", "tags"],
      "properties": {
        "asset_id": {
          "type": "string",
          "description": "Unique asset identifier. Format: vid-NNNN | img-NNNN | aud-NNNN"
        },
        "file_name": {
          "type": "string",
          "description": "Original filename including extension."
        },
        "media_type": {
          "type": "string",
          "enum": ["video", "image", "audio"],
          "description": "Media type of the asset."
        },
        "duration_sec": {
          "type": ["number", "null"],
          "description": "Duration in seconds. Null for images."
        },
        "resolution": {
          "type": ["string", "null"],
          "description": "Resolution string e.g. '1920x1080'. Null for audio."
        },
        "file_size_bytes": {
          "type": "integer",
          "description": "File size in bytes."
        },
        "thumbnail_url": {
          "type": ["string", "null"],
          "description": "Relative URL to representative thumbnail."
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp of when the asset was ingested."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Auto-generated semantic tags from AI pipeline."
        }
      }
    },
    "TagDetail": {
      "type": "object",
      "required": ["name", "category", "source"],
      "properties": {
        "name": { "type": "string", "description": "The tag term." },
        "category": { "type": "string", "enum": ["location", "content_type", "theme"], "description": "Tag group." },
        "source": { "type": "string", "enum": ["auto", "user_confirmed"], "description": "Source of tag." }
      }
    },
    "MoodDetail": {
      "type": "object",
      "required": ["label", "score"],
      "properties": {
        "label": { "type": "string", "description": "Name of mood." },
        "score": { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "Confidence score." }
      }
    },
    "OccurrenceDetail": {
      "type": "object",
      "required": ["timestamp_start_sec", "timestamp_end_sec", "confidence"],
      "properties": {
        "timestamp_start_sec": { "type": "number", "description": "Start time in seconds." },
        "timestamp_end_sec": { "type": "number", "description": "End time in seconds." },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "Confidence score." }
      }
    },
    "DetectedObjectDetail": {
      "type": "object",
      "required": ["name", "occurrences"],
      "properties": {
        "name": { "type": "string", "description": "UPPERCASE name of detected object." },
        "occurrences": {
          "type": "array",
          "items": { "ref": "OccurrenceDetail" }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "description": "Unified error envelope for all 4xx and 5xx responses.",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "description": "Machine-readable error code.",
              "examples": ["ASSET_NOT_FOUND", "JOB_NOT_FOUND", "INVALID_REQUEST", "PIPELINE_ERROR", "SERVICE_UNAVAILABLE", "VALIDATION_ERROR"]
            },
            "message": {
              "type": "string",
              "description": "Human-readable error description."
            },
            "detail": {
              "type": ["object", "null"],
              "description": "Optional structured detail, e.g. Pydantic validation errors."
            }
          }
        }
      }
    }
  },
  "endpoints": {
    "POST /api/v1/ingest": {
      "summary": "Trigger AI ingestion pipeline for a media source directory.",
      "owner": "M2 (backend endpoint), M1 (pipeline consumer)",
      "http_method": "POST",
      "path": "/api/v1/ingest",
      "request": {
        "content_type": "application/json",
        "body": {
          "type": "object",
          "required": ["source_path", "options"],
          "properties": {
            "source_path": {
              "type": "string",
              "description": "Absolute path to the media directory or single file on the server.",
              "example": "/app/data/media"
            },
            "options": {
              "type": "object",
              "required": ["scene_detection", "transcription", "vision_caption", "whisper_model"],
              "properties": {
                "scene_detection": {
                  "type": "boolean",
                  "description": "Run PySceneDetect to split video into scenes.",
                  "default": true
                },
                "transcription": {
                  "type": "boolean",
                  "description": "Run Whisper ASR for audio transcription.",
                  "default": true
                },
                "vision_caption": {
                  "type": "boolean",
                  "description": "Run Llama 3.2 Vision for scene captioning.",
                  "default": true
                },
                "whisper_model": {
                  "type": "string",
                  "enum": ["tiny", "base", "small", "medium", "large"],
                  "description": "Whisper model size. Larger = more accurate but slower.",
                  "default": "base"
                }
              }
            }
          },
          "example": {
            "source_path": "/app/data/media",
            "options": {
              "scene_detection": true,
              "transcription": true,
              "vision_caption": true,
              "whisper_model": "base"
            }
          }
        }
      },
      "response": {
        "202": {
          "description": "Ingestion job accepted and queued.",
          "content_type": "application/json",
          "body": {
            "type": "object",
            "required": ["job_id", "status", "assets_queued", "message"],
            "properties": {
              "job_id": {
                "type": "string",
                "description": "Unique job identifier. Format: ingest-YYYYMMDD-NNN"
              },
              "status": {
                "type": "string",
                "enum": ["queued", "processing", "done", "failed"]
              },
              "assets_queued": {
                "type": "integer",
                "description": "Number of media files discovered and queued."
              },
              "message": {
                "type": "string",
                "description": "Human-readable status message."
              }
            },
            "example": {
              "job_id": "ingest-20240821-001",
              "status": "queued",
              "assets_queued": 14,
              "message": "Ingestion pipeline started."
            }
          }
        },
        "400": { "ref": "ErrorResponse" },
        "422": { "ref": "ErrorResponse" }
      }
    },
    "GET /api/v1/ingest/status/{job_id}": {
      "summary": "Poll the current status and progress of a running ingestion job.",
      "owner": "M2 (backend), M3 (frontend polling fallback)",
      "http_method": "GET",
      "path": "/api/v1/ingest/status/{job_id}",
      "path_parameters": {
        "job_id": {
          "type": "string",
          "description": "The job ID returned from POST /api/v1/ingest.",
          "example": "ingest-20240821-001"
        }
      },
      "response": {
        "200": {
          "description": "Current job status and progress.",
          "content_type": "application/json",
          "body": {
            "type": "object",
            "required": ["job_id", "status", "progress_pct", "assets_total", "assets_processed"],
            "properties": {
              "job_id": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["queued", "processing", "done", "failed"]
              },
              "progress_pct": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "Completion percentage."
              },
              "assets_total": {
                "type": "integer",
                "description": "Total assets in this job."
              },
              "assets_processed": {
                "type": "integer",
                "description": "Assets fully processed so far."
              },
              "current_file": {
                "type": ["string", "null"],
                "description": "Filename currently being processed."
              },
              "started_at": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC timestamp when job started."
              },
              "updated_at": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC timestamp of last status update."
              },
              "error_message": {
                "type": ["string", "null"],
                "description": "Populated only when status is 'failed'."
              }
            },
            "example": {
              "job_id": "ingest-20240821-001",
              "status": "processing",
              "progress_pct": 57,
              "assets_total": 14,
              "assets_processed": 8,
              "current_file": "vacation_reel_2024.mp4",
              "started_at": "2024-08-21T09:15:42Z",
              "updated_at": "2024-08-21T09:18:05Z",
              "error_message": null
            }
          }
        },
        "404": { "ref": "ErrorResponse" }
      }
    },
    "POST /api/v1/search": {
      "summary": "Semantic vector search over ingested media assets.",
      "owner": "M2 (backend), M3 (frontend search UI)",
      "http_method": "POST",
      "path": "/api/v1/search",
      "request": {
        "content_type": "application/json",
        "body": {
          "type": "object",
          "required": ["query"],
          "properties": {
            "query": {
              "type": "string",
              "description": "Natural language search query.",
              "example": "person walking on a beach at sunset"
            },
            "filters": {
              "type": "object",
              "properties": {
                "media_type": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["video", "image", "audio"]
                  },
                  "description": "Filter by media type. Empty array = no filter.",
                  "default": []
                },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Filter by tags. Empty array = no filter.",
                  "default": []
                },
                "asset_id": {
                  "type": "string",
                  "description": "Filter by specific asset ID (In-Video Search support).",
                  "default": null
                }
              }
            },
            "top_k": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "Maximum number of results to return."
            }
          },
          "example": {
            "query": "person walking on a beach at sunset",
            "filters": {
              "media_type": ["video", "image"],
              "tags": [],
              "asset_id": "vid-0042"
            },
            "top_k": 5
          }
        }
      },
      "response": {
        "200": {
          "description": "Search results ranked by semantic similarity score.",
          "content_type": "application/json",
          "body": {
            "type": "object",
            "required": ["query", "total_results", "results"],
            "properties": {
              "query": { "type": "string" },
              "total_results": { "type": "integer" },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["asset_id", "file_name", "media_type", "file_path", "score", "scene", "tags"],
                  "properties": {
                    "asset_id": { "type": "string" },
                    "file_name": { "type": "string" },
                    "media_type": {
                      "type": "string",
                      "enum": ["video", "image", "audio"]
                    },
                    "file_path": { "type": "string" },
                    "thumbnail_url": { "type": ["string", "null"] },
                    "score": {
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "description": "Cosine similarity score."
                    },
                    "scene": { "ref": "SceneSnippet" },
                    "tags": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            },
            "example": {
              "query": "person walking on a beach at sunset",
              "total_results": 1,
              "results": [
                {
                  "asset_id": "vid-0042",
                  "file_name": "vacation_reel_2024.mp4",
                  "media_type": "video",
                  "file_path": "/app/data/media/vacation_reel_2024.mp4",
                  "thumbnail_url": "/thumbnails/vid-0042-scene3.jpg",
                  "score": 0.94,
                  "scene": {
                    "scene_index": 3,
                    "timestamp_start_sec": 142.5,
                    "timestamp_end_sec": 161.0,
                    "caption": "A person walks along a sandy beach at golden hour.",
                    "transcript_snippet": "This was the most peaceful evening."
                  },
                  "tags": ["beach", "golden hour", "walking", "outdoors"]
                }
              ]
            }
          }
        },
        "400": { "ref": "ErrorResponse" },
        "422": { "ref": "ErrorResponse" }
      }
    },
    "GET /api/v1/assets": {
      "summary": "Paginated list of all ingested assets.",
      "owner": "M2 (backend), M3 (frontend asset library view)",
      "http_method": "GET",
      "path": "/api/v1/assets",
      "query_parameters": {
        "page": {
          "type": "integer",
          "default": 1,
          "description": "Page number (1-indexed)."
        },
        "page_size": {
          "type": "integer",
          "default": 20,
          "maximum": 100,
          "description": "Items per page."
        },
        "media_type": {
          "type": ["string", "null"],
          "enum": ["video", "image", "audio"],
          "description": "Optional filter by media type."
        },
        "sort_by": {
          "type": "string",
          "enum": ["ingested_at", "file_name", "duration_sec"],
          "default": "ingested_at"
        },
        "sort_order": {
          "type": "string",
          "enum": ["asc", "desc"],
          "default": "desc"
        }
      },
      "response": {
        "200": {
          "description": "Paginated asset list.",
          "content_type": "application/json",
          "body": {
            "type": "object",
            "required": ["page", "page_size", "total_assets", "total_pages", "assets"],
            "properties": {
              "page": { "type": "integer" },
              "page_size": { "type": "integer" },
              "total_assets": { "type": "integer" },
              "total_pages": { "type": "integer" },
              "assets": {
                "type": "array",
                "items": { "ref": "AssetSummary" }
              }
            },
            "example": {
              "page": 1,
              "page_size": 20,
              "total_assets": 142,
              "total_pages": 8,
              "assets": [
                {
                  "asset_id": "vid-0042",
                  "file_name": "vacation_reel_2024.mp4",
                  "media_type": "video",
                  "duration_sec": 312.4,
                  "resolution": "1920x1080",
                  "file_size_bytes": 248310784,
                  "thumbnail_url": "/thumbnails/vid-0042-scene0.jpg",
                  "ingested_at": "2024-08-21T09:15:42Z",
                  "tags": ["travel", "beach", "mountain"]
                }
              ]
            }
          }
        }
      }
    },
    "GET /api/v1/assets/{asset_id}": {
      "summary": "Full detail of a single asset including all scenes.",
      "owner": "M2 (backend), M3 (frontend asset detail view)",
      "http_method": "GET",
      "path": "/api/v1/assets/{asset_id}",
      "path_parameters": {
        "asset_id": {
          "type": "string",
          "description": "Unique asset identifier.",
          "example": "vid-0042"
        }
      },
      "response": {
        "200": {
          "description": "Full asset detail with all scenes.",
          "content_type": "application/json",
          "body": {
            "type": "object",
            "required": ["asset_id", "file_name", "media_type", "file_size_bytes", "file_path", "ingested_at", "scenes", "tags", "summary", "moods", "objects", "best_for"],
            "properties": {
              "asset_id": { "type": "string" },
              "file_name": { "type": "string" },
              "media_type": {
                "type": "string",
                "enum": ["video", "image", "audio"]
              },
              "duration_sec": { "type": ["number", "null"] },
              "resolution": { "type": ["string", "null"] },
              "file_size_bytes": { "type": "integer" },
              "file_path": { "type": "string" },
              "ingested_at": {
                "type": "string",
                "format": "date-time"
              },
              "scenes": {
                "type": "array",
                "items": { "ref": "SceneDetail" }
              },
              "full_transcript": { "type": ["string", "null"] },
              "tags": {
                "type": "array",
                "items": { "ref": "TagDetail" }
              },
              "summary": { "type": ["string", "null"], "description": "AI-generated asset summary." },
              "moods": {
                "type": "array",
                "items": { "ref": "MoodDetail" }
              },
              "objects": {
                "type": "array",
                "items": { "ref": "DetectedObjectDetail" }
              },
              "best_for": {
                "type": "array",
                "items": { "ref": "TagDetail" }
              }
            },
            "example": {
              "asset_id": "vid-0042",
              "file_name": "vacation_reel_2024.mp4",
              "media_type": "video",
              "duration_sec": 312.4,
              "resolution": "1920x1080",
              "file_size_bytes": 248310784,
              "file_path": "/app/data/media/vacation_reel_2024.mp4",
              "ingested_at": "2024-08-21T09:15:42Z",
              "summary": "A beautiful cinematic travel vlog showcasing the natural beauty of Sweden.",
              "moods": [
                { "label": "CALM", "score": 0.95 },
                { "label": "RELAXING", "score": 0.85 }
              ],
              "objects": [
                {
                  "name": "BRIDGE",
                  "occurrences": [
                    { "timestamp_start_sec": 0.0, "timestamp_end_sec": 1.6, "confidence": 0.95 },
                    { "timestamp_start_sec": 3.2, "timestamp_end_sec": 4.8, "confidence": 0.88 }
                  ]
                }
              ],
              "best_for": [
                { "name": "TRAVEL FILM", "category": "theme", "source": "auto" }
              ],
              "scenes": [
                {
                  "scene_index": 0,
                  "timestamp_start_sec": 0.0,
                  "timestamp_end_sec": 48.2,
                  "caption": "Aerial drone footage over mountains at dawn.",
                  "transcript_snippet": "We started early to catch the sunrise.",
                  "thumbnail_url": "/thumbnails/vid-0042-scene0.jpg",
                  "embedding_id": "emb-vid0042-s0"
                }
              ],
              "full_transcript": "We started early to catch the sunrise. The mountains were covered in mist...",
              "tags": [
                { "name": "travel", "category": "theme", "source": "auto" },
                { "name": "sweden", "category": "location", "source": "auto" }
              ]
            }
          }
        },
        "404": { "ref": "ErrorResponse" }
      }
    },
    "POST /api/v1/assets/{asset_id}/reingest": {
      "summary": "Trigger video re-analysis and scene detection.",
      "owner": "M2 (backend), M3 (frontend)",
      "http_method": "POST",
      "path": "/api/v1/assets/{asset_id}/reingest",
      "path_parameters": {
        "asset_id": {
          "type": "string",
          "description": "Unique asset identifier.",
          "example": "vid-0042"
        }
      },
      "request": {
        "content_type": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "options": {
              "type": "object",
              "properties": {
                "scene_detection": { "type": "boolean", "default": true },
                "transcription": { "type": "boolean", "default": true },
                "vision_caption": { "type": "boolean", "default": true }
              }
            }
          }
        }
      },
      "response": {
        "202": {
          "description": "Re-ingestion job accepted and queued.",
          "content_type": "application/json",
          "body": {
            "type": "object",
            "required": ["job_id", "status", "message"],
            "properties": {
              "job_id": { "type": "string" },
              "status": { "type": "string", "enum": ["queued", "processing", "done", "failed"] },
              "message": { "type": "string" }
            },
            "example": {
              "job_id": "job-reingest-20240821-002",
              "status": "queued",
              "message": "Re-ingestion pipeline started."
            }
          }
        },
        "404": { "ref": "ErrorResponse" }
      }
    },
    "POST /api/v1/assets/{asset_id}/regenerate-insights": {
      "summary": "Trigger LLM/Vision analysis on existing keyframes to regenerate metadata.",
      "owner": "M2 (backend), M3 (frontend)",
      "http_method": "POST",
      "path": "/api/v1/assets/{asset_id}/regenerate-insights",
      "path_parameters": {
        "asset_id": {
          "type": "string",
          "description": "Unique asset identifier.",
          "example": "vid-0042"
        }
      },
      "response": {
        "202": {
          "description": "Regeneration job accepted and queued.",
          "content_type": "application/json",
          "body": {
            "type": "object",
            "required": ["job_id", "status", "message"],
            "properties": {
              "job_id": { "type": "string" },
              "status": { "type": "string", "enum": ["queued", "processing", "done", "failed"] },
              "message": { "type": "string" }
            },
            "example": {
              "job_id": "job-regen-20240821-003",
              "status": "queued",
              "message": "Regenerate insights job started."
            }
          }
        },
        "404": { "ref": "ErrorResponse" }
      }
    }
  },
  "websocket": {
    "ws/ingest/{job_id}": {
      "summary": "Real-time push updates for ingestion progress.",
      "owner": "M2 (backend), M3 (frontend progress UI)",
      "url_pattern": "ws://localhost:8000/ws/ingest/{job_id}",
      "events": {
        "connected": {
          "description": "Sent immediately after a successful WebSocket connection.",
          "schema": {
            "type": "object",
            "required": ["event", "job_id", "message"],
            "properties": {
              "event": { "type": "string", "enum": ["connected"] },
              "job_id": { "type": "string" },
              "message": { "type": "string" }
            },
            "example": {
              "event": "connected",
              "job_id": "ingest-20240821-001",
              "message": "Subscribed to job updates."
            }
          }
        },
        "progress": {
          "description": "Sent periodically as each asset is processed.",
          "schema": {
            "type": "object",
            "required": ["event", "job_id", "progress_pct", "assets_processed", "assets_total", "timestamp"],
            "properties": {
              "event": { "type": "string", "enum": ["progress"] },
              "job_id": { "type": "string" },
              "progress_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
              "assets_processed": { "type": "integer" },
              "assets_total": { "type": "integer" },
              "current_file": { "type": ["string", "null"] },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "example": {
              "event": "progress",
              "job_id": "ingest-20240821-001",
              "progress_pct": 57,
              "assets_processed": 8,
              "assets_total": 14,
              "current_file": "vacation_reel_2024.mp4",
              "timestamp": "2024-08-21T09:18:05Z"
            }
          }
        },
        "completed": {
          "description": "Sent once when all assets have been processed successfully.",
          "schema": {
            "type": "object",
            "required": ["event", "job_id", "progress_pct", "assets_processed", "assets_total", "timestamp"],
            "properties": {
              "event": { "type": "string", "enum": ["completed"] },
              "job_id": { "type": "string" },
              "progress_pct": { "type": "integer" },
              "assets_processed": { "type": "integer" },
              "assets_total": { "type": "integer" },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "example": {
              "event": "completed",
              "job_id": "ingest-20240821-001",
              "progress_pct": 100,
              "assets_processed": 14,
              "assets_total": 14,
              "timestamp": "2024-08-21T09:22:31Z"
            }
          }
        },
        "failed": {
          "description": "Sent when the pipeline encounters a fatal error.",
          "schema": {
            "type": "object",
            "required": ["event", "job_id", "progress_pct", "error_message", "timestamp"],
            "properties": {
              "event": { "type": "string", "enum": ["failed"] },
              "job_id": { "type": "string" },
              "progress_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
              "error_message": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "example": {
              "event": "failed",
              "job_id": "ingest-20240821-001",
              "progress_pct": 57,
              "error_message": "CUDA out of memory on file: large_video.mp4",
              "timestamp": "2024-08-21T09:19:44Z"
            }
          }
        }
      }
    }
  }
}
